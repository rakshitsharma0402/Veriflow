  "html": "<div style=\"font-family: Arial, sans-serif; padding: 20px;\">\n    <h2 style=\"border-bottom: 2px solid #333; padding-bottom: 10px;\">\n        Validation Exception — Compliance Report\n    </h2>\n\n    <table style=\"width: 100%; margin-top: 20px; border-collapse: collapse;\">\n        <tr>\n            <td style=\"width: 40%; padding: 6px 0; color: #555;\"><strong>Exception ID</strong></td>\n            <td>{{ doc.name }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Merchant Record</strong></td>\n            <td>{{ doc.merchant_record }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Data Quality Rule</strong></td>\n            <td>{{ doc.data_quality_rule }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Failure Reason</strong></td>\n            <td>{{ doc.failure_reason }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Severity</strong></td>\n            <td>{{ doc.severity }}</td>\n        </tr>\n    </table>\n\n    <h3 style=\"margin-top: 30px; border-bottom: 1px solid #ccc; padding-bottom: 6px;\">\n        Review Outcome\n    </h3>\n\n    <table style=\"width: 100%; margin-top: 10px; border-collapse: collapse;\">\n        <tr>\n            <td style=\"width: 40%; padding: 6px 0; color: #555;\"><strong>Status</strong></td>\n            <td>{{ doc.status }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Reviewed By</strong></td>\n            <td>{{ doc.reviewed_by or \"—\" }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Review Comment</strong></td>\n            <td>{{ doc.review_comment or \"—\" }}</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 6px 0; color: #555;\"><strong>Reviewed On</strong></td>\n            <td>{{ doc.reviewed_on or \"—\" }}</td>\n        </tr>\n    </table>\n\n    <p style=\"margin-top: 40px; font-size: 11px; color: #999; border-top: 1px solid #eee; padding-top: 10px;\">\n        Generated by Veriflow — {{ frappe.utils.now() }}\n    </p>\n</div>",
